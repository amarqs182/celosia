#!/bin/sh
# Refuse pushes to the original upstream repository.
set -eu

remote_name=${1:-unknown}
remote_url=${2:-}

case "$remote_url" in
    *HenryKun55/celosia*|*HenryKun55:celosia*)
        printf '%s\n' "ERROR: pushes to HenryKun55/celosia are forbidden." >&2
        printf '%s\n' "Push only to amarqs182/celosia (origin)." >&2
        exit 1
        ;;
esac

exit 0
